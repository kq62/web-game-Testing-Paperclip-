# The game itself ships as plain files and needs no build. node_modules exists
# only so `qa/smoke.mjs` can drive a real browser via puppeteer-core.
node_modules/
package-lock.json

# Screenshots are regenerated by `node qa/smoke.mjs`; the run that produced them
# is what matters, not the pixels.
qa/screenshots/

# Per-machine agent/editor settings, not project configuration.
.claude/
